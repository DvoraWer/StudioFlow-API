<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>77db8978-a4b0-4ed2-a0cb-e06d9faa4258</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- API references Core + Service for real work, and Data ONLY so that
         Program.cs can register the DbContext and repository implementations. -->
    <ProjectReference Include="..\StudioFlow.Core\StudioFlow.Core.csproj" />
    <ProjectReference Include="..\StudioFlow.Service\StudioFlow.Service.csproj" />
    <ProjectReference Include="..\StudioFlow.Data\StudioFlow.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core design-time (migrations). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- JWT bearer authentication handler. Not part of the ASP.NET Core shared
         framework since .NET 3.0, so it must be referenced explicitly (spec §19, §20). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />

    <!-- OpenAPI / Swagger UI — "Swagger documenting all endpoints" (course
         requirements Part B/1). -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />

    <!-- NLog as the provider under Microsoft.Extensions.Logging / ILogger<T> (spec §34). -->
    <PackageReference Include="NLog.Web.AspNetCore" Version="5.3.14" />
  </ItemGroup>

  <ItemGroup>
    <None Update="nlog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
