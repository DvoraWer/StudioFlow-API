<?xml version="1.0" encoding="utf-8" ?>
<!--
  StudioFlow logging (spec §34).
  NLog sits under Microsoft.Extensions.Logging; application code keeps using ILogger<T>.
  Levels: Debug (dev diagnostics), Information (normal meaningful operations),
          Warning (handled anomalies incl. concurrency conflicts), Error (unexpected).
  The correlation id set by CorrelationIdMiddleware (ILogger BeginScope) is rendered
  as ${scopeproperty:item=CorrelationId}.
  Never logged: passwords, password hashes, JWT tokens, request bodies/headers.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/nlog-internal.log">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <targets>
    <target xsi:type="ColoredConsole" name="console"
            layout="${time}|${level:uppercase=true:padding=-5}|${logger:shortName=true}|cid=${scopeproperty:item=CorrelationId:whenEmpty=-}|${message}${onexception:${newline}${exception:format=type,message,method}}" />

    <target xsi:type="File" name="file"
            fileName="${basedir}/logs/studioflow-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|cid=${scopeproperty:item=CorrelationId:whenEmpty=-}|${aspnet-request-method:whenEmpty=} ${aspnet-request-url:whenEmpty=}|${message}${onexception:${newline}${exception:format=tostring}}"
            keepFileOpen="true"
            concurrentWrites="false"
            archiveNumbering="Date"
            archiveEvery="Day"
            maxArchiveFiles="7" />
  </targets>

  <rules>
    <!-- keep host lifecycle lines ("Now listening on…", "Application started") -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="console,file" final="true" />

    <!-- quiet framework noise below Warning (EF SQL, routing, model binding, etc.) -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <!-- application code -->
    <logger name="*" minlevel="Debug" writeTo="console" />
    <logger name="*" minlevel="Info" writeTo="file" />
  </rules>
</nlog>
